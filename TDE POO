        }
        double saldoAtualCC = contaCorrente.getSaldo() - (contaCorrente.getSaldo() + contaCorrente.getTarifaFixa());

        System.out.println("Saldo: " + saldoAtualCC);
    }

    public static void sacarCP(Scanner scan, ContaPoupanca contaPoupanca) {
