        System.out.println("Saldo mínimo pós saque: " + contaPoupanca.getSaldoMinimo());
        System.out.println("\nDigite o valor que deseja sacar: ");
        double valorCP = scan.nextDouble();
        double saldoAtualCP = contaPoupanca.getSaldo() - valorCP;
        if (saldoAtualCP < contaPoupanca.getSaldoMinimo()) {
            System.out.println("Seu saldo final não pode ser menor que o valor de saldo mínimo!");
            saldoAtualCP = contaPoupanca.getSaldo() + valorCP;
        }
        System.out.println("Saldo final: " + saldoAtualCP);

    }

