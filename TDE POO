    public static void abrirConta() {
        Scanner sc = new Scanner(System.in);
        Random gerar = new Random();
        boolean entradaValida = false;
        do {
            try {
                System.out.println("C = Conta corrente");
                System.out.println("P = Conta Poupanca");
                String opcaoConta = sc.nextLine();
                String opcaoUpper = opcaoConta.toUpperCase();
                char primeiraLetraOpcao = opcaoUpper.charAt(0); // Pega só a primeira letra da opcao

                entradaValida = true;

                //conta corrente
                if (primeiraLetraOpcao == 'C') {
                    ContaCorrente contaCorrente = new ContaCorrente();
                    System.out.print("Digite o nome titular: ");
                    String nomeTitularC = sc.nextLine();
                    contaCorrente.setTitular(nomeTitularC);
                    int numC = gerar.nextInt(9999); // GERAR NÚMERO ALEATÓRIO
                    contaCorrente.setNumeroConta(numC);
                    System.out.println("Titular: " + contaCorrente.getTitular());
                    System.out.println("Conta: " + contaCorrente.getNumeroConta());
                    System.out.println("Saldo: " + contaCorrente.getSaldo());
                    System.out.println("Conta aberta com sucesso! \n");

                    //conta poupanca
                } else if (primeiraLetraOpcao == 'P') {
                    ContaPoupanca contaPoupanca = new ContaPoupanca();
                    System.out.println("Digite o nome titular: ");
                    String nomeTitularP = sc.nextLine();
                    contaPoupanca.setTitular(nomeTitularP);
                    int numP = gerar.nextInt(9999); // GERAR NÚMERO ALEATÓRIO
                    contaPoupanca.setNumeroConta(numP);
                    System.out.println("Conta: " + contaPoupanca.getTitular());
                    System.out.println("Saldo: " + contaPoupanca.getSaldo());
                    System.out.println("Conta aberta com sucesso! \n");
                }

            } catch (Exception e) {
                System.out.println("Erro: Digite C ou P!");
            }
        } while (entradaValida = false);
    }

    public static void sacarCC(Scanner scan, ContaCorrente contaCorrente) {
